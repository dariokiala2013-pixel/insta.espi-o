{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/proxy/instagram.php*",
      "destination": "/api/proxy/instagram"
    },
    {
      "source": "/api/proxy/leads.php*",
      "destination": "/api/proxy/leads"
    },
    {
      "source": "/api/proxy/image-proxy.php*",
      "destination": "/api/proxy/image-proxy"
    },
    {
      "source": "/api/proxy/hikerapi.php*",
      "destination": "/api/proxy/hikerapi"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
